{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../..",
  "testRegex": "test/unit-test/.*\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "collectCoverageFrom": [
    "src/auth/auth.service.ts",
    "src/work-order/work-order.service.ts",
    "src/service-request/service-request.service.ts",
    "src/membership/membership.service.ts",
    "src/service/services.internal.service.ts",
    "src/invitations/invitations.service.ts",
    "src/fcm/fcm.service.ts",
    "src/form/helpers/form-validation.helper.ts"
  ],
  "coverageDirectory": "./coverage/unit",
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1"
  }
}
